    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nif (rows.length === 0) {\n  return [];\n}\n\nconst escapeHtml = (value) =>\n  String(value ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n\nconst records = rows.map((item) => {\n  const row = item.json;\n\n  return `\n    <tr>\n      <td>${escapeHtml(row.Name)}</td>\n      <td>${escapeHtml(row.Course)}</td>\n      <td>${escapeHtml(row.Status)}</td>\n    </tr>\n  `;\n}).join(\"\");\n\nconst subject = `CAIE Course Program - Data Summary (${rows.length} records)`;\n\nconst body = `\n  <div style=\"font-family: Arial, sans-serif; color: #333;\">\n    <h2>CAIE Course Program</h2>\n    <p>Hi,</p>\n    <p>Here is the latest data from the Google Sheet.</p>\n    <p><strong>Total records:</strong> ${rows.length}</p>\n\n    <table style=\"border-collapse: collapse; width: 100%;\">\n      <thead>\n        <tr style=\"background-color: #e8f0fe;\">\n          <th style=\"padding: 10px; border: 1px solid #ddd;\">Name</th>\n          <th style=\"padding: 10px; border: 1px solid #ddd;\">Course</th>\n          <th style=\"padding: 10px; border: 1px solid #ddd;\">Status</th>\n        </tr>\n      </thead>\n      <tbody>${records}</tbody>\n    </table>\n\n    <p>Regards,<br>Your Automation Bot</p>\n  </div>\n`;\n\nreturn [{\n  json: {\n    subject,\n    body,\n    recordCount: rows.length\n  }\n}];\n"
      },
